{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auto-crypto-simulation",
  "main": "src/worker.py",
  "compatibility_flags": ["python_workers"],
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["17 */8 * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "auto-crypto-sim",
    "database_id": "1f599656-7852-47dc-b9ff-8b3fa4f9d976",
    "migrations_dir": "migrations"
  }],
  "ai": {"binding": "AI"},
  // Run next to the D1 database: one page load does ~20 queries, so this avoids 20 cross-ocean round trips.
  "placement": { "mode": "smart" },
  "services": [{"binding":"EXECUTOR","service":"auto-crypto-executor"},{"binding":"FETCHER","service":"auto-crypto-fetcher"}],
  // No plain vars: SETTINGS_JSON and email settings are pushed as Worker secrets from GitHub Actions secrets.
  "keep_vars": false
}

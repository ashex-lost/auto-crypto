{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auto-crypto-simulation",
  "main": "src/worker.py",
  "compatibility_flags": ["python_workers"],
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["*/30 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "auto-crypto-sim",
    "database_id": "1f599656-7852-47dc-b9ff-8b3fa4f9d976",
    "migrations_dir": "migrations"
  }],
  "ai": {"binding": "AI"},
  "services": [{"binding":"EXECUTOR","service":"auto-crypto-executor"}],
  // SETTINGS_JSON is private: set it as a Secret, never here. keep_vars stops deploys from wiping dashboard values.
  "keep_vars": true
}

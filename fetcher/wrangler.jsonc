{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "auto-crypto-fetcher",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  // Run next to Binance's servers in Tokyo: requests from some other regions are refused.
  "placement": { "region": "aws:ap-northeast-1" }
}
